{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "randcrw launcher",
  "mainBinaryName": "randcrw-launcher",
  "version": "0.1.0",
  "identifier": "com.randcrw.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ratchet & Clank: ReWrite",
        "width": 1180,
        "height": 740,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0f1c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher for randcrw (Ratchet & Clank: ReWrite)",
    "longDescription": "randcrw (Ratchet & Clank: ReWrite) is a native rewrite of the PlayStation 2 game. The launcher installs the game data once from your own disc image, manages game versions and starts the game.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
